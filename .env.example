# Copy this file to .env and fill in your values locally.
#   cp .env.example .env
#
# Never commit .env — it is listed in .gitignore.

# Google API key (required for pipeline orchestrator / preprocessing plan)
# Get one at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Model used by the orchestrator agent (default: Gemini 3.5 Flash)
GEMINI_MODEL=gemini-3.5-flash

# Cursor API key (required for scripts/promotion_advisor.py)
# Get one at: https://cursor.com/dashboard/api
CURSOR_API_KEY=

# Model used by the promotion advisor script
CURSOR_MODEL=claude-sonnet-4-6
CURSOR_MODEL_FAST=false
CURSOR_MODEL_REASONING=low

# URL of the running prediction API (required for scripts/promotion_advisor.py)
# Example: http://127.0.0.1:60329
PREDICTION_API_URL=

# Optional logging level override (INFO, DEBUG, WARNING, ERROR)
# LOG_LEVEL=INFO
